// H5 补全：非注解/半注解闭包值绑定（`let f = |x| x + y; f(..)`）。
// 参数类型确定规则：有注解的参数用注解类型（调用点实参须兼容），
// 无注解的参数由首次调用点实参推断（延迟固化），随后按闭包值路径调用。
fn main() {
    // 半注解：x 注解 i64，y 由实参推断
    let f = |x: i64, y| x + y;
    println(f(20, 22));             // 42

    // 全无注解：参数类型全部由首次调用点实参推断
    let g = |a, b| a * b;
    println(g(6, 7));               // 42

    // 无注解 + 按值捕获（多次调用：首次调用固化为闭包值对象并重绑定变量）
    let base = 40;
    let h = |x| x + base;
    println(h(1));                  // 41
    println(h(2));                  // 42

    // 无注解 + String 实参（字面量自动升级）
    let s = |t| t + "!";
    println(s("rlyeh"));             // rlyeh!
}
