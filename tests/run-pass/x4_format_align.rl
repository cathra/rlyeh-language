// X4：对齐格式占位符（`{:>10}` 右 / `{:<5}` 左 / `{:^8}` 居中 / `{:*>10}` 自定义填充）
// 用 std `pad_start`/`pad_end` 实现对齐；居中经 (width - len)/2 计算左填充。
fn main() {
    // 1. 右对齐：{:>10}  → "         7"（7 前 9 个空格补到 10 宽）
    println!("{:>10}", 7);
    // 2. 左对齐：{:<5}  → "ab   "（ab 后 3 个空格）
    println!("{:<5}", "ab");
    // 3. 居中：{:^8}  → "  rlyeh "（rlyeh 5 宽，8-5=3，左 1 右 2）
    println!("{:^8}", "rlyeh");
    // 4. 自定义填充：{:*>10} → "*******42"（42 前 8 个 * 补到 10 宽）
    println!("{:*>10}", 42);
    // 5. 宽度不足则原样（{:>2} 对 123）→ "123"
    println!("{:>2}", 123);
}
