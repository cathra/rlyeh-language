// X2（2026-08-30）：TOML 固定数组 `[T; N]` 反序列化（扁平 + 嵌套）。
// - 扁平 `[i64; 3]`：`[1, 2, 3]` → [1, 2, 3]
// - 嵌套 `[[i64; 2]; 2]`：`[ [1, 2], [3, 4] ]` → [[1,2],[3,4]]
fn main() -> i64 {
    let arr = toml::from_str::<[i64; 3]>("[1, 2, 3]");
    println(arr[0] + arr[1] + arr[2]); // 6
    let m = toml::from_str::<[[i64; 2]; 2]>("[ [1, 2], [3, 4] ]");
    println(m[0][0] + m[0][1] + m[1][0] + m[1][1]); // 10
    0
}
