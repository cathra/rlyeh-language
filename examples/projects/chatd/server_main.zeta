// ===== chatd-server 入口 =====
//
// 启动 NIO 聊天服务器，监听 127.0.0.1:9888。
// MVP 无命令行参数 API（args），端口硬编码于此，修改后重新编译。
// 构建：scripts/build.sh；运行：./chatd-server

mod protocol;
mod hub;
mod server;

use hub::Hub;
use server::run_server;

fn main() {
    println("chatd server: 127.0.0.1:9888 (Ctrl-C to stop)");
    let mut hub = Hub::new();
    let _ = run_server(9888, &mut hub);
    println("server exited");
}
