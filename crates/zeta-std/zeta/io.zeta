// ===== io 模块（B2，2026-08）：libc stdio 文件 IO + 控制台 IO =====
// 基于通用 FFI（extern fn，阶段 A4）直接绑定 libc 符号，由链接器解析。
// 底层 extern（fopen/fread/fwrite/fclose/fseek/ftell/read）声明于根模块
// core.zeta 的 extern 集中区；String 在 LIR 中即 data 指针（i8*），
// 可直接作为 C 字符串 / 缓冲传入 extern。
// 路径参数需 NUL 结尾（c_str 构造）；读入缓冲后由调用方手动设置 len。

// 复制 s 并附加 NUL 终止符，返回仅用于 C 字符串参数的拷贝。
// 返回值的 len 为内容长度（不含 NUL）；data[len] 处为 0。
fn c_str(s: String) -> String {
    let mut buf = String::with_capacity(s.len + 1);
    let mut i = 0;
    while i < s.len {
        buf.push_byte(s.data[i]);
        i = i + 1;
    }
    buf.push_byte(0);   // 附加 NUL（容量 s.len + 1 保证可写）
    buf.len = s.len;    // 恢复内容长度
    buf
}

// 读整个文件为 String（打开失败返回空串；MVP 无 io Result 类型）。
// 单次 fread：文件大小已知（fseek SEEK_END + ftell），普通文件一次可读满。
fn read_file(path: String) -> String {
    let cpath = c_str(path);
    let f = fopen(cpath, String::from("r"));
    if f == 0 {
        return String::from("");
    }
    let _end = fseek(f, 0, 2);   // SEEK_END = 2，文件字节数
    let size = ftell(f);
    let _set = fseek(f, 0, 0);   // SEEK_SET = 0，回到开头
    let mut buf = String::with_capacity(size);
    let n = fread(buf, 1, size, f);
    buf.len = n;                 // 实际读入字节数（空文件 n = 0）
    let _ = fclose(f);
    buf
}

// 写入整个文件（"w" 截断写）；返回写入字节数，失败返回 -1。
fn write_file(path: String, content: String) -> i64 {
    let cpath = c_str(path);
    let f = fopen(cpath, String::from("w"));
    if f == 0 {
        return -1;
    }
    let n = fwrite(content, 1, content.len, f);
    let _ = fclose(f);
    n
}

// 追加写入（"a"）；返回写入字节数，失败返回 -1。
fn append_file(path: String, content: String) -> i64 {
    let cpath = c_str(path);
    let f = fopen(cpath, String::from("a"));
    if f == 0 {
        return -1;
    }
    let n = fwrite(content, 1, content.len, f);
    let _ = fclose(f);
    n
}

// 从 stdin（fd 0）读取一行，不含换行符（无输入则返回空串）。
fn read_line() -> String {
    let mut tmp = String::with_capacity(256);
    let n = read(0, tmp, 256);
    let mut buf = String::new();
    let mut i = 0;
    while i < n {
        if tmp.data[i] == 10 {   // '\n'
            break;
        }
        buf.push_byte(tmp.data[i]);
        i = i + 1;
    }
    buf
}
