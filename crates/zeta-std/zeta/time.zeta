// ===== 时间模块（MVP）：Duration / Instant =====
// 底层时钟 extern `clock()`（libc，POSIX CLOCKS_PER_SEC=1e6，返回微秒）
// 声明于根模块 core.zeta 的 extern 集中区。语言层无常量定义，
// 1e6 以字面量 1000000 使用。

// 时长：以微秒为唯一存储单位，各单位视图由换算方法提供。
struct Duration {
    micros: i64,
}

impl Duration {
    // 秒（向下取整）
    fn secs(self) -> i64 {
        self.micros / 1000000
    }
    // 毫秒
    fn millis(self) -> i64 {
        self.micros / 1000
    }
    // 微秒
    fn micros(self) -> i64 {
        self.micros
    }
    // 纳秒
    fn nanos(self) -> i64 {
        self.micros * 1000
    }
}

// 时刻：记录起始微秒，`elapsed` 计算与当前时刻的差值。
struct Instant {
    start: i64,
}

impl Instant {
    // 当前时刻（进程 CPU 时钟）
    fn now() -> time::Instant {
        time::Instant { start: clock() }
    }
    // 距 `now` 已过时长（CPU 时钟差，恒 >= 0）
    fn elapsed(self) -> time::Duration {
        time::Duration { micros: clock() - self.start }
    }
}
